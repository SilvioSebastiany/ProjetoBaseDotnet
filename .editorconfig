root = true

[*]
indent_style = space
indent_size = 4
end_of_line = crlf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{json,yml,yaml,xml,csproj,props}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
# Domínio em português sem acento; classes nunca record; nullable reference types desabilitado
# (Nullable é configurado em Directory.Build.props, não por regra do editorconfig)
csharp_style_namespace_declarations = file_scoped:suggestion
csharp_prefer_simple_using_statement = true:suggestion
dotnet_diagnostic.CS8632.severity = none
